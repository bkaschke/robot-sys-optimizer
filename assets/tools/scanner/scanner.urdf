<robot name="scanner">
  <link name="scanner_body">
    <visual><geometry><mesh filename="meshes/scanner_body.stl"/></geometry></visual>
    <collision><geometry><mesh filename="meshes/scanner_body.stl"/></geometry></collision>
    <inertial>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <mass value="1.6"/>
      <inertia ixx="1e-3" ixy="0" ixz="0" iyy="1e-3" iyz="0" izz="1e-3"/>
    </inertial>
  </link>

</robot>
